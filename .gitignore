# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# next.js
/.next/
/out/

# copied from node_modules/maplibre-gl by scripts/copy-maplibre-worker.mjs
/public/maplibre/

# generated from the database by scripts/publish-all.ts; committing these
# would recreate exactly the problem this architecture exists to avoid
/public/artifacts/

# cut from the database by scripts/build-tiles.ts, for the same reason —
# public/data/borders/ is what committed map data looks like and this milestone
# exists to delete it
/public/tiles/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# working notes and SDD workspace (not part of the shipped project)
HANDOVER.md
docs/superpowers/
.superpowers/

# env files (explicit; .env* above already covers these, kept for clarity)
.env
.env.*
!.env.example

# Local notes and AI-assistant instructions. Kept on disk, never published.
# AGENTS.md is regenerated by `next dev`, so it has to be ignored, not just deleted.
notex.md
AGENTS.md
CLAUDE.md
