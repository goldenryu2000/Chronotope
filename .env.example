# Local Postgres via docker-compose. The password is docker-compose.yml's
# local-only default, not a secret; the secret scan is told so.
# secretlint-disable
DATABASE_URL=postgres://postgres:chronotope@localhost:5432/chronotope
DATABASE_URL_TEST=postgres://postgres:chronotope@localhost:5432/chronotope_test
# secretlint-enable

# The previous static build's content directory, one pack per subfolder.
# Read by scripts/import-legacy.ts and by the three test files that import
# content for real, so `npm test` needs it to point somewhere valid. There is
# no default: set it to where that directory lives on your machine.
LEGACY_CONTENT_DIR=/path/to/PhilMap/content

# Artifacts are written to public/artifacts/ and served by Next.js.
NEXT_PUBLIC_ARTIFACT_BASE_URL=/artifacts

# ---- Production -------------------------------------------------------------
# Unused locally. Copy the first group into .env.deploy (gitignored, chmod 600)
# on the machine you publish from, then `make deploy-data`. Scripts read it
# through ENV_FILE; `next dev` never does.
#
# secretlint-disable
# DATABASE_URL=postgresql://neondb_owner:...@ep-....ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#   (the DIRECT string, without -pooler: migrations need a session)
# LEGACY_CONTENT_DIR=
# STORAGE=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=chronotope-assets
# APP_ROLE_PASSWORD=   (openssl rand -hex 24)
# VERCEL_DEPLOY_HOOK_URL=
#
# The second group is set in Vercel's project settings, never in a file:
# DATABASE_URL=postgresql://chronotope_app:...@ep-...-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# NEXT_PUBLIC_ARTIFACT_BASE_URL=https://assets.<domain>/artifacts
# NEXT_PUBLIC_TILES_BASE_URL=https://assets.<domain>
# NEXT_PUBLIC_SOURCE_URL=https://github.com/<owner>/chronotope
# NEXT_PUBLIC_CONTACT_EMAIL=
# secretlint-enable
